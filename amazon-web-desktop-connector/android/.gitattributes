# Normalize line endings for text files
# This ensures reproducible builds across different platforms
* text=auto eol=lf

# Explicitly set LF for markdown files
*.md text eol=lf
*.txt text eol=lf

# Binary files should be left as-is
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.apk binary
*.jks binary
*.jar binary
*.so binary
*.dex binary
