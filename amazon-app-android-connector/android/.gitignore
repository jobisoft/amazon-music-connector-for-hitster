# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/
build/
*/build/

# Gradle files
.gradle/
build/
!gradle-wrapper.jar

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log
hs_err_*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio
*.iml
.idea/
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/**/gradle.xml
.idea/**/libraries
.idea/**/assetWizardSettings.xml
.idea/caches/
.idea/modules.xml
.idea/navEditor.xml
.idea/vcs.xml

# Keystore files (signing keys - NEVER commit these!)
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# Fastlane reports and generated files
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
fastlane/readme.md

# Generated Fastlane metadata files (auto-generated via Gradle tasks)
fastlane/metadata/android/en-US/changelogs/*.txt
fastlane/metadata/android/en-US/images/icon.png

# Auto-copied files (generated during build)
app/src/main/assets/CHANGELOG.md
app/src/main/assets/LICENSES_THIRD_PARTY.md

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
/ios/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# Android Profiling
*.hprof

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Kotlin
.kotlin/
*.kt.swp

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~

# Lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Version control
vcs.xml

# Build reports
build/reports/
build/configuration-cache/

# Kotlin build cache
.kotlin/

# Gradle build cache
.gradle/caches/
.gradle/daemon/

# Android build cache
android/.cxx/
android/app/build/
android/.gradle/

